NODE_ENV=development
PORT=5000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rfid_reader_catalog
DB_USER=root
DB_PASSWORD=123456

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Initial admin account (used by `npm run seed:admin`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Public base URL of this API (used to build absolute file/photo URLs)
API_BASE_URL=http://localhost:5000
